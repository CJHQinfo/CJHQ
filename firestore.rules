rules_version = '2';

// CJHQ website — Firestore security rules
//
// Model: the site is a public, read-only website with a small private admin
// panel. Everything the public sees must be readable by anyone; nothing should
// be writable by anyone who is not signed in.
//
// This is the minimum secure rule set for the current architecture. It does not
// introduce roles, per-document ownership, or custom claims, because the app
// has a single trusted editor group and does not need them.
//
// IMPORTANT: publishing these rules will stop the admin panel from saving until
// Firebase Authentication is wired into it. The admin panel currently gates on
// a client-side PIN, which Firestore cannot see. See CJHQ_Firestore_Security.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // Collections that render on the public site.
    // Public read is required. Writes require an authenticated session.
    match /notices/{doc}                 { allow read: if true; allow write: if request.auth != null; }
    match /partners/{doc}                { allow read: if true; allow write: if request.auth != null; }
    match /partner_overrides/{doc}       { allow read: if true; allow write: if request.auth != null; }
    match /resources/{doc}               { allow read: if true; allow write: if request.auth != null; }
    match /resource_overrides/{doc}      { allow read: if true; allow write: if request.auth != null; }
    match /resource_meta/{doc}           { allow read: if true; allow write: if request.auth != null; }
    match /events/{doc}                  { allow read: if true; allow write: if request.auth != null; }
    match /settings/{doc}                { allow read: if true; allow write: if request.auth != null; }
    match /content_overrides/{doc}       { allow read: if true; allow write: if request.auth != null; }
    match /custom_pages/{doc}            { allow read: if true; allow write: if request.auth != null; }
    match /page_settings/{doc}           { allow read: if true; allow write: if request.auth != null; }

    // Internal / operational collections. Not rendered publicly.
    match /reviewed_overrides/{doc}      { allow read: if request.auth != null; allow write: if request.auth != null; }
    match /pending_change_notices/{doc}  { allow read: if request.auth != null; allow write: if request.auth != null; }
    match /link_audits/{doc}             { allow read: if request.auth != null; allow write: if request.auth != null; }

    // Anything not explicitly listed above is denied outright. New collections
    // must be added here deliberately rather than inheriting public access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
